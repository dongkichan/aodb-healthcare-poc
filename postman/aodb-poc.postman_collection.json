{
  "info": {
    "name": "AODB proof of concept",
    "description": "Synthetic data only. Run the requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sign in as staff-a",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/dev/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dev",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"handle\": \"staff-a\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('tokenStaffA', pm.response.json().access_token);",
              "pm.test('signed in', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
