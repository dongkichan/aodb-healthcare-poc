    {
      "name": "1. Create request (CL-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requests"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenStaffA}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client\": \"CL-01\",\n  \"workflow\": \"appointment_change\",\n  \"external_ref\": \"PM-{{$timestamp}}\",\n  \"summary\": \"Caller asked to move the visit to a morning slot and confirm by phone.\",\n  \"fields\": {\n    \"client_reference\": \"PM-REF\",\n    \"requested_window\": \"AM\",\n    \"callback_confirmed\": true\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('requestId', pm.response.json().request_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Guidance search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/guidance/search?request={{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "guidance",
            "search"
          ],
          "query": [
            {
              "key": "request",
              "value": "{{requestId}}"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenStaffA}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('five passages', () => pm.expect(pm.response.json().results.length).to.eql(5));"
            ]
          }
        }
      ]
    },
