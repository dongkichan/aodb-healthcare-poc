# Local settings for the proof of concept. The values are left empty on purpose.
# Create .env with random values:   ./scripts/init-env.sh
# (or copy this file to .env and fill each value with any long random string)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
NEO4J_PASSWORD=
JWT_SECRET=
# Local development only. Leave at 0 anywhere the API port is reachable by others.
POC_DEV_TOKENS=1
POC_FAULT_INJECTION=1
